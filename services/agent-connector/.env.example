NODE_ENV=development
PORT=4100
# Generate a unique random token of at least 32 characters before sharing/deployment.
CONNECTOR_API_TOKEN=replace-this-with-a-random-secret-token-at-least-32-chars
CORS_ORIGIN=http://localhost:3000
CONNECTOR_MODE=mock
REQUEST_TIMEOUT_MS=4000
MAX_BATCH_CONCURRENCY=4

# Live integrations: set mode=live and configure the relevant base URLs.
DATABASE_BASE_URL=
DATABASE_HEALTH_PATH=/internal/health
DATABASE_METRICS_PATH=/internal/metrics
DATABASE_LOGS_PATH=/internal/logs
DATABASE_API_TOKEN=

AUTH_BASE_URL=
AUTH_HEALTH_PATH=/internal/health
AUTH_METRICS_PATH=/internal/metrics
AUTH_LOGS_PATH=/internal/logs
AUTH_API_TOKEN=

EXTERNAL_API_BASE_URL=
EXTERNAL_API_HEALTH_PATH=/health
EXTERNAL_API_METRICS_PATH=/metrics
EXTERNAL_API_LOGS_PATH=/logs
EXTERNAL_API_TOKEN=
