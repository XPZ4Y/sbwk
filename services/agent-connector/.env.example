NODE_ENV=development
PORT=4100
CONNECTOR_API_TOKEN=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:3000
CONNECTOR_MODE=mock
REQUEST_TIMEOUT_MS=4000
MAX_BATCH_CONCURRENCY=4

# Real service integrations. Set CONNECTOR_MODE=live to use these.
SERVER_BASE_URL=http://localhost:3001
SERVER_HEALTH_PATH=/internal/health
SERVER_METRICS_PATH=/internal/metrics
SERVER_LOGS_PATH=/internal/logs

DATABASE_MONITOR_URL=http://localhost:3002
DATABASE_HEALTH_PATH=/internal/health
DATABASE_METRICS_PATH=/internal/metrics

AUTH_BASE_URL=http://localhost:3003
AUTH_HEALTH_PATH=/internal/health
AUTH_METRICS_PATH=/internal/metrics
AUTH_LOGS_PATH=/internal/logs

EXTERNAL_API_BASE_URL=http://localhost:3004
EXTERNAL_API_HEALTH_PATH=/health
EXTERNAL_API_METRICS_PATH=/metrics

# Optional read-only Git repository integration.
GIT_REPOSITORY_PATH=
GIT_BRANCH=main

# Optional CI/CD provider integration using a read-only HTTP endpoint.
CICD_BASE_URL=
CICD_DEPLOYMENTS_PATH=/api/deployments
CICD_API_TOKEN=
