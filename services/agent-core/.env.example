NODE_ENV=development
PORT=4200

# Shared secret with the Middleware (>= 32 chars). Middleware sends this as Bearer.
AGENT_CORE_TOKEN=development-only-change-this-agent-token-123456
CORS_ORIGIN=http://localhost:3000

# Reasoning mode. "mock" uses a built-in heuristic reasoner (no API key needed).
# "live" calls Groq; falls back to the heuristic reasoner if the call fails.
AGENT_MODE=mock
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_MS=20000

# ── Prompt engineering (test different ways of prompting Groq) ─────────────
# balanced | concise | diff_first | strict_json | sre_checklist
GROQ_PROMPT_PROFILE=balanced
# Full overrides. Leave empty to use the selected profile's prompt.
# Template variables: {{incident}} {{evidence}} {{dependencyFindings}}
# {{codeFindings}} {{recentCommits}} {{recurring}} {{repoUrl}} {{liquid}} {{tools}}
GROQ_SYSTEM_PROMPT=
GROQ_PROMPT_TEMPLATE=
# Empty = the profile's own defaults.
GROQ_TEMPERATURE=
GROQ_MAX_TOKENS=

# ── Liquid AI d1 triage router ────────────────────────────────────────────
# Decides engineer-intervention vs "call Groq AI" BEFORE any generative call.
# Leave LIQUID_API_KEY empty to default every incident to Groq AI.
LIQUID_API_KEY=
LIQUID_MODEL=d1
LIQUID_BASE_URL=https://api.liquid.ai
LIQUID_DECISIONS_PATH=/decisions/v1/systemone
LIQUID_TIMEOUT_MS=8000
LIQUID_MAX_STATE_CHARS=6000
LIQUID_ENABLED=true
# Optional JSON overrides. Examples:
# LIQUID_ROUTE_POLICY={"urgentThreshold":0.6,"frustrationThreshold":1.5,"engineerDepartments":["billing","sales"],"default":"groq"}
# LIQUID_QUESTIONS={"department":{"type":"choice","instructions":"Which team should handle this?","criteria":{"billing":"Payments, invoicing, refunds","technical":"Bugs, outages, integrations","sales":"Pricing, upgrades, new accounts"}},"is_urgent":{"type":"noul","instructions":"Does this convey urgency?"},"frustration":{"type":"score","instructions":"How frustrated is the customer?","criteria":["Calm","Frustrated","Very angry"]}}

# Attach the redacted request/response JSON of each AI call to the analysis
# (also always printed to console.log).
AI_DEBUG=true

# Agent Connector (the hands). Use the Compose DNS name in Docker.
CONNECTOR_URL=http://localhost:4100
CONNECTOR_API_TOKEN=development-only-change-this-token-123456
REQUEST_TIMEOUT_MS=5000
INVESTIGATE_SERVICES=database,auth,external_api

# Read-only codebase the agent may inspect for relevant source.
CODEBASE_PATH=
CODEBASE_MAX_FILES=400
CODEBASE_MAX_FINDINGS=6

# Context retention.
MAX_CONTEXT_INCIDENTS=200
# Persist context to this directory (empty = in-memory only).
DATA_DIR=

# Safety limits (onboarding Step 04). The control plane can update these at runtime.
DRY_RUN=true
AUTO_ROLLBACK=true
MONITORING_ACTIVE=true

# Escalation / Notification (wake the engineer).
ESCALATION_CONFIDENCE_THRESHOLD=0.5
# Optional webhook (e.g. Slack). Always logged regardless.
NOTIFICATION_WEBHOOK_URL=

# ── Lazy two-stage gate (POST /incidents/batch) ───────────────────────────
# Middleware buffers bad requests and sends ONE batch once a pattern forms.
# Liquid d1 answers a single noul question over the log digest:
#   probability <  threshold  → incidents stored as "skipped" (no Groq, no cost)
#   probability >= threshold  → each incident runs through the normal pipeline
BATCH_LIQUID_ANOMALY_THRESHOLD=0.6
# If Liquid cannot answer the gate: "investigate" (default, keeps signal) or
# "skip" (accept the miss; logged loudly).
LIQUID_BATCH_FALLBACK=investigate
# Hard cap on incidents accepted in one batch.
BATCH_MAX_INCIDENTS=50
