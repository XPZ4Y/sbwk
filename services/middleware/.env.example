NODE_ENV=development
PORT=8080

# The application Server that clients are transparently proxied to.
TARGET_SERVER_URL=http://localhost:8000

# Agent Core receives anomaly dispatches. Use the Compose DNS name in Docker.
AGENT_CORE_URL=http://localhost:4200
# Shared secret; must match Agent Core's AGENT_CORE_TOKEN (>= 32 chars).
AGENT_CORE_TOKEN=development-only-change-this-agent-token-123456
# Protects the middleware's own /_sbwk admin endpoints (>= 32 chars).
MIDDLEWARE_ADMIN_TOKEN=development-only-change-this-admin-token-123456

# Detection: flag responses with status >= this value.
# 500 = server errors only. Set 400 to also catch client errors like 404.
DETECT_STATUS_MIN=500
# Also flag responses slower than this many milliseconds (0 = disabled).
DETECT_SLOW_MS=2000
# Also dispatch when the upstream Server is unreachable or times out.
DETECT_UPSTREAM_ERRORS=true

# De-duplicate identical anomalies (method+path+status) within this window.
DISPATCH_COOLDOWN_MS=15000
DISPATCH_TIMEOUT_MS=5000
# Max bytes of the upstream response body captured as incident evidence.
RESPONSE_SAMPLE_BYTES=2048
PROXY_TIMEOUT_MS=30000
MAX_RECENT_INCIDENTS=200

# ── Lazy two-stage gate (opt-in) ───────────────────────────────────────────
# "immediate" (default) = dispatch every anomaly the moment it is detected.
# "batch"               = buffer bad requests and only wake Agent Core when a
#                         PATTERN forms. Liquid d1 then decides whether the
#                         pattern is worth a real LLM call at all.
DETECT_MODE=immediate
# Wake condition: this many bad requests inside BATCH_WINDOW_MS.
BATCH_MIN_BAD=5
BATCH_WINDOW_MS=60000
# Hard cap on buffered incidents (bounded ring buffer).
BATCH_MAX_SIZE=50
# Optional trickle drain: flush a partial batch after this long (0 = never;
# only a threshold crossing wakes the agent).
BATCH_FLUSH_TIMEOUT_MS=0
# How often the buffer re-evaluates its window (lightweight; no I/O).
BATCH_SWEEP_MS=1000
# Timeout for the whole batch round trip (Liquid gate + investigations).
BATCH_TIMEOUT_MS=25000
# If the batch endpoint itself is unreachable: "investigate" replays every
# incident through the normal per-incident dispatch (the real agent path, so
# nothing is dropped) or "skip" accepts the miss. Default keeps the signal.
LIQUID_BATCH_FALLBACK=investigate

# ── Dumb activation function (see activation.mjs) ─────────────────────────
# Two rules, no learning, no statistics — just comparisons you can predict.
#
# IMPULSE: one severe bad request skips the "wait for a pattern" rule. Severe
# means a 5xx, an unreachable/timed-out upstream, a repeat failure on the same
# path, or a response slower than BATCH_IMPULSE_SEVERE_MS.
# Set false to make the count threshold the only way to wake the agent.
BATCH_IMPULSE=true
BATCH_IMPULSE_SEVERE_MS=5000
#
# TRIVIAL: answer recognised noise locally (scanner paths like /.env, /wp-login.php,
# favicon/robots probes, plain 401/403 from clients not logging in) instead of
# spending a Liquid call on it — but ONLY when every incident in the batch is
# trivial; one real incident disables the shortcut.
# Off by default: this filters traffic, so opt in knowingly.
BATCH_SKIP_TRIVIAL=false
