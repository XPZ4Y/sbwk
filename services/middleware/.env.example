NODE_ENV=development
PORT=8080

# The application Server that clients are transparently proxied to.
TARGET_SERVER_URL=http://localhost:8000

# Agent Core receives anomaly dispatches. Use the Compose DNS name in Docker.
AGENT_CORE_URL=http://localhost:4200
# Shared secret; must match Agent Core's AGENT_CORE_TOKEN (>= 32 chars).
AGENT_CORE_TOKEN=development-only-change-this-agent-token-123456
# Protects the middleware's own /_sbwk admin endpoints (>= 32 chars).
MIDDLEWARE_ADMIN_TOKEN=development-only-change-this-admin-token-123456

# Detection: flag responses with status >= this value.
# 500 = server errors only. Set 400 to also catch client errors like 404.
DETECT_STATUS_MIN=500
# Also flag responses slower than this many milliseconds (0 = disabled).
DETECT_SLOW_MS=2000
# Also dispatch when the upstream Server is unreachable or times out.
DETECT_UPSTREAM_ERRORS=true

# De-duplicate identical anomalies (method+path+status) within this window.
DISPATCH_COOLDOWN_MS=15000
DISPATCH_TIMEOUT_MS=5000
# Max bytes of the upstream response body captured as incident evidence.
RESPONSE_SAMPLE_BYTES=2048
PROXY_TIMEOUT_MS=30000
MAX_RECENT_INCIDENTS=200
