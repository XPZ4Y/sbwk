# SBWK root environment for docker compose.
# Generate strong secrets, e.g.:  openssl rand -hex 32
# These MUST be set because the services run with NODE_ENV=production in compose.

# Shared between Middleware and Agent Core.
AGENT_CORE_TOKEN=replace-with-a-random-secret-at-least-32-characters
# Protects the Middleware /_sbwk admin endpoints.
MIDDLEWARE_ADMIN_TOKEN=replace-with-another-random-secret-at-least-32-chars
# Shared between Agent Core and Agent Connector.
CONNECTOR_API_TOKEN=replace-with-a-third-random-secret-at-least-32-chars

# Detection threshold: 500 = server errors only; 400 also catches 404, etc.
DETECT_STATUS_MIN=500
DISPATCH_COOLDOWN_MS=15000

# Reasoning: "mock" needs no API key; "live" uses Groq (falls back to mock on error).
AGENT_MODE=mock
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Connector integrations: "mock" for demos; "live" to hit real dependencies.
CONNECTOR_MODE=mock

# Optional: wake engineers via a webhook (e.g. Slack). Always logged regardless.
NOTIFICATION_WEBHOOK_URL=
